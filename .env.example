# LectureMindAI configuration. Copy to backend/.env (local) or set in your environment.
# Every value has a safe default; only override what you need.

# --- Ollama (local LLM; free) ---------------------------------------------------
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b            # `ollama pull qwen2.5:1.5b`
ALLOWED_MODELS=                   # comma-separated; defaults to LLM_MODEL
OLLAMA_TIMEOUT=120                # seconds before a stuck LLM call fails with HTTP 504
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.0

# --- Models ---------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2  # text embeddings (SentenceTransformers)
CLIP_MODEL=openai/clip-vit-base-patch32   # video-frame embeddings
WHISPER_MODEL=base                # tiny (fast) | base | small | medium (slow, better)
WHISPER_TIMEOUT=900               # wall-clock seconds allowed for one transcription

# --- Chunking (larger chunks = more context per hit but blurrier retrieval;
#     more overlap = fewer ideas cut at boundaries but more duplicated text) ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ------------------------------------------------------------------
TOP_K=4                           # chunks sent to the LLM
# Minimum score of the best chunk; below it the API answers "not found" without calling the LLM.
# Leave unset for the default (0.15 cosine; 0.125 when USE_RERANKER=1). Calibrate with `python -m eval.run threshold`.
# RELEVANCE_THRESHOLD=0.15
IMAGE_MIN_SCORE=0.2               # minimum CLIP text->frame similarity
FRAME_SAMPLE_INTERVAL=7           # seconds between sampled video frames

# Optional quality features from the evaluation work (off = plain dense retrieval, lowest memory).
USE_HYBRID=0
USE_RERANKER=0
USE_GROUNDING_CHECK=0
# Best measured quality (docs/evaluation.md section 9): USE_HYBRID=1, USE_RERANKER=1,
# RERANKER_MODEL=models/reranker-lecturemind (train with eval.finetune_reranker), RELEVANCE_THRESHOLD=0.30
# RERANK_FUSION=1 and RERANK_FUSION_WEIGHT=2 blend the reranker's ranking with the hybrid ranking (section 10)

# --- Storage --------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/chat_history.db

# --- Resource limits (checked BEFORE any expensive processing) -------------------
MAX_PDF_SIZE_MB=25
MAX_MEDIA_SIZE_MB=500
MAX_MEDIA_DURATION_MINUTES=30
MAX_STORAGE_PER_SESSION_MB=500
MAX_DOCUMENTS_PER_SESSION=20
MAX_CONCURRENT_INGESTIONS=1       # heavy ingestions run one at a time (protects RAM)
MAX_HISTORY_MESSAGES=10           # chat turns sent to the LLM for query rewriting

# --- Rate limiting (requests per minute per client IP) ---------------------------
RATE_LIMIT_QUERY=10
RATE_LIMIT_UPLOAD=5

# --- CORS: comma-separated frontend origins. Use * for local development only. ----
CORS_ORIGINS=http://localhost:3000

# --- Frontend (frontend/.env.local) ----------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
