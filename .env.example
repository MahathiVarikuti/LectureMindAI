# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLIP_MODEL=openai/clip-vit-base-patch32

# Whisper
WHISPER_MODEL=base
WHISPER_TIMEOUT=600

# Chunking (trade-off: larger chunks = more context per chunk but less precise retrieval)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Video frame sampling (seconds between frames)
FRAME_SAMPLE_INTERVAL=7

# Storage paths
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/chat_history.db

# Resource limits
MAX_PDF_SIZE_MB=25
MAX_MEDIA_DURATION_MINUTES=30
MAX_STORAGE_PER_SESSION_MB=500
MAX_DOCUMENTS_PER_SESSION=20

# Rate limiting (requests per minute)
RATE_LIMIT_QUERY=10
RATE_LIMIT_UPLOAD=5

# CORS (comma-separated origins; use * for dev only)
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
